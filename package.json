{
  "name": "donbin",
  "version": "1.0.0",
  "description": "A Discord Music Bot connecting with YouTube and BiliBili",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "build": "tsc",
    "test": "node node_modules/typescript/bin/tsc && node --test test/*.test.mjs",
    "lint": "tsc --noEmit",
    "register": "node dist/register.js",
    "start": "node dist/index.js",
    "dev": "node node_modules/typescript/bin/tsc && node dist/index.js",
    "media-check": "node dist/media-check.js"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.0",
    "discord.js": "^14.22.1",
    "dotenv": "^17.2.2",
    "opusscript": "^0.0.8"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "typescript": "^5.9.2"
  }
}
