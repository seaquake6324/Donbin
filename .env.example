# Developer Portal > Bot > Token
DISCORD_TOKEN=
# Developer Portal > General Information > Application ID
DISCORD_CLIENT_ID=
# Developer Portal > OAuth2 > Client Secret (keep private)
DISCORD_CLIENT_SECRET=
# Right-click the server icon > Copy Server ID
DISCORD_GUILD_ID=
# Your Discord user ID; legacy playlists are assigned to this account during migration.
ADMIN_DISCORD_USER_ID=
# Default voice channel when the user has no saved voice channel
MUSIC_VOICE_CHANNEL_ID=
DATABASE_PATH=./data/music.sqlite
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
# Exact public browser origin; register WEB_PUBLIC_URL/auth/discord/callback in Developer Portal > OAuth2 > Redirects.
# For local testing use http://127.0.0.1:3000
WEB_PUBLIC_URL=http://127.0.0.1:3000
# Generate a random value of at least 32 characters and keep it unchanged across restarts.
WEB_SESSION_SECRET=
WEB_HOST=127.0.0.1
WEB_PORT=3000
# Optional: yt-dlp cookies file for videos that require login.
# YTDLP_COOKIES_PATH=
